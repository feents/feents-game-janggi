+std::string Position::feents_end_reason() const {
+  if (!var->feentsRules) return "";
+  if (checkers())
+  {
+      bool escape = false;
+      for (const auto& move : MoveList<EVASIONS>(*this))
+          if (legal(move)) { escape = true; break; }
+      if (!escape) return "checkmate";
+  }
+  if (var->feentsMaterial && (feents_points(WHITE) < 10 || feents_points(BLACK) < 10)) return "material";
+  if (st->pliesFromNull > 0 && st->bikjang && st->previous->bikjang) return "bikjang";
+  if (st->pliesFromNull > 0 && st->pass && st->previous->pass) return "double-pass";
+  if (MoveList<LEGAL>(*this).size() == 0) return "no-legal-move";
+  return "";
+}
